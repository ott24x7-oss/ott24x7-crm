{
  "manifest_version": 3,
  "name": "WA-CRM — WhatsApp CRM",
  "short_name": "WA-CRM",
  "version": "3.11.0",
  "description": "Turn WhatsApp Web into a CRM: product catalog, AI assistant, lead capture, follow-ups and bulk send — from the number you already use.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://wa-crm.in/*",
    "https://heyroute.ai/*",
    "https://*.heyroute.ai/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wpp-config.js",
        "wa-js.js",
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "minimum_chrome_version": "111",
  "options_page": "options.html"
}
