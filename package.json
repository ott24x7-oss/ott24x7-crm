{
  "name": "ott24x7-crm",
  "version": "0.26.0",
  "description": "WA-CRM \u2014 WhatsApp CRM/sender on the open-source WPPConnect engine",
  "author": "WA-CRM",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "cross-env OTT_SMOKE=1 electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ott24x7.crm",
    "productName": "WA-CRM",
    "artifactName": "WA-CRM-Setup-${version}.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "assets/**",
      "config.js"
    ],
    "win": {
      "icon": "assets/wa-crm.ico",
      "target": [
        "nsis"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ott24x7-oss",
        "repo": "ott24x7-crm-releases"
      }
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "xlsx": "^0.18.5"
  }
}
