{
  "name": "ott24x7-crm",
  "version": "0.5.0",
  "description": "ott24x7 CRM — WhatsApp CRM/sender on the open-source WPPConnect engine",
  "author": "ott24x7",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "cross-env OTT_SMOKE=1 electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ott24x7.crm",
    "productName": "ott24x7 CRM",
    "artifactName": "ott24x7-CRM-Setup-${version}.exe",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "assets/**",
      "config.js"
    ],
    "win": {
      "icon": "assets/ott24x7.ico",
      "target": "nsis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ott24x7-oss",
        "repo": "ott24x7-crm-releases"
      }
    ]
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "xlsx": "^0.18.5"
  }
}
