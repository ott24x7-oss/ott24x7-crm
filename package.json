{
  "name": "ott24x7-crm",
  "version": "0.3.0",
  "description": "ott24x7 CRM — WhatsApp CRM/sender on the open-source WPPConnect engine",
  "author": "ott24x7",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "cross-env OTT_SMOKE=1 electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.ott24x7.crm",
    "productName": "ott24x7 CRM",
    "directories": { "output": "release" },
    "files": ["electron/**", "renderer/**", "assets/**", "config.js"],
    "win": { "icon": "assets/ott24x7.ico", "target": "nsis" }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "cross-env": "^7.0.3"
  }
}
